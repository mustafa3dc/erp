<Window x:Class="DesktopHost.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="ZiloX Business Suite • Cloud POS &amp; Inventory ERP"
        Height="900" Width="1440"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen"
        Background="#0F172A"
        FontFamily="Segoe UI, Tahoma, Arial">

    <Grid>
        <!-- Loading Placeholder while WebView2 initializes -->
        <Border x:Name="LoadingOverlay" Background="#0F172A" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Panel.ZIndex="10">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="⚡ ZiloX ERP &amp; Cloud POS" FontSize="26" FontWeight="ExtraBold" Foreground="#38BDF8" HorizontalAlignment="Center"/>
                <TextBlock Text="جاري تحميل واجهة نقطة البيع..." FontSize="13" Foreground="#94A3B8" HorizontalAlignment="Center" Margin="0,8,0,16"/>
                <ProgressBar Width="220" Height="4" IsIndeterminate="True" Background="#1E293B" Foreground="#2563EB" BorderThickness="0"/>
            </StackPanel>
        </Border>

        <!-- WebView2 Host Control -->
        <wv2:WebView2 x:Name="WebViewControl" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
    </Grid>
</Window>

