<Window x:Class="DesktopHost.Views.ActivationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="تفعيل ترخيص ZiloX ERP &amp; Cloud POS"
        Height="540" Width="640"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        FlowDirection="RightToLeft"
        FontFamily="Segoe UI, Tahoma, Arial">

    <Border CornerRadius="16" Background="#0F172A" BorderBrush="#334155" BorderThickness="1.5">
        <Border.Effect>
            <DropShadowEffect BlurRadius="25" ShadowDepth="4" Opacity="0.4" Color="Black"/>
        </Border.Effect>

        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Header -->
                <RowDefinition Height="Auto"/> <!-- Machine ID Card -->
                <RowDefinition Height="*"/>    <!-- License Input -->
                <RowDefinition Height="Auto"/> <!-- Status / Error Alert -->
                <RowDefinition Height="Auto"/> <!-- Action Buttons -->
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Width="44" Height="44" CornerRadius="10" Background="#1E293B" BorderBrush="#3B82F6" BorderThickness="1">
                    <TextBlock Text="🛡️" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="تفعيل ترخيص النظام (Hardware Lock)" FontSize="17" FontWeight="Bold" Foreground="#F8FAFC"/>
                    <TextBlock Text="ZiloX Business Suite • حماية النسخ وربط الترخيص بعتاد الجهاز" FontSize="11" Foreground="#94A3B8" Margin="0,2,0,0"/>
                </StackPanel>

                <Button Grid.Column="2" Content="✕" Width="30" Height="30" 
                        Background="Transparent" Foreground="#94A3B8" BorderThickness="0" 
                        FontSize="14" Cursor="Hand" Click="OnCloseClicked"/>
            </Grid>

            <!-- Machine ID Display Card -->
            <Border Grid.Row="1" Background="#1E293B" CornerRadius="12" BorderBrush="#334155" BorderThickness="1" Padding="14" Margin="0,0,0,16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="بصمة هذا الجهاز الفريدة (Machine ID):" FontSize="12" FontWeight="SemiBold" Foreground="#38BDF8"/>
                    
                    <TextBox Grid.Row="1" Grid.Column="0" x:Name="TxtMachineId" IsReadOnly="True" 
                             FontSize="18" FontWeight="Bold" FontFamily="Consolas, monospace" 
                             Background="Transparent" Foreground="#F1F5F9" BorderThickness="0" 
                             Margin="0,4,0,0" VerticalAlignment="Center"/>

                    <Button Grid.Row="0" Grid.RowSpan="2" Grid.Column="1" Content="📋 نسخ الكود" 
                            Padding="12,6" Background="#2563EB" Foreground="White" FontWeight="Bold" FontSize="11"
                            BorderThickness="0" Cursor="Hand" Click="OnCopyMachineIdClicked">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="8"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </Grid>
            </Border>

            <!-- License Key Input -->
            <StackPanel Grid.Row="2" Margin="0,0,0,12">
                <Grid Margin="0,0,0,6">
                    <TextBlock Text="أدخل مفتاح التفعيل (License Key):" FontSize="12" FontWeight="SemiBold" Foreground="#E2E8F0"/>
                    <Button Content="📂 استيراد ملف ترخيص (.lic)" HorizontalAlignment="Left" 
                            Background="Transparent" Foreground="#60A5FA" BorderThickness="0" FontSize="11" 
                            Cursor="Hand" Click="OnImportLicenseFileClicked"/>
                </Grid>

                <TextBox x:Name="TxtLicenseKey" Height="95" TextWrapping="Wrap" AcceptsReturn="False"
                         Background="#1E293B" Foreground="#E2E8F0" BorderBrush="#334155" BorderThickness="1"
                         FontFamily="Consolas, monospace" FontSize="11" Padding="8" VerticalScrollBarVisibility="Auto">
                    <TextBox.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="8"/>
                        </Style>
                    </TextBox.Resources>
                </TextBox>
                <TextBlock Text="قم بنسخ المفتاح المرسل لك من قبل المطور والصقه بالكامل في المربع أعلاه." FontSize="10" Foreground="#64748B" Margin="0,4,0,0"/>
            </StackPanel>

            <!-- Status Alert Box -->
            <Border Grid.Row="3" x:Name="AlertBorder" Visibility="Collapsed" CornerRadius="8" Padding="10" Margin="0,0,0,16" Background="#7F1D1D" BorderBrush="#EF4444" BorderThickness="1">
                <TextBlock x:Name="TxtStatusMessage" Text="رسالة تنبيه الترخيص" FontSize="11" FontWeight="SemiBold" Foreground="#FEE2E2" TextWrapping="Wrap"/>
            </Border>

            <!-- Footer Action Buttons -->
            <Grid Grid.Row="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Content="إغلاق وخروج" Width="100" Height="38" 
                        Background="#334155" Foreground="#CBD5E1" FontWeight="SemiBold" FontSize="12" 
                        BorderThickness="0" Cursor="Hand" Click="OnCloseClicked">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="8"/>
                        </Style>
                    </Button.Resources>
                </Button>

                <Button Grid.Column="2" Content="✓ تفعيل وتشغيل النظام" Width="170" Height="38" 
                        Background="#059669" Foreground="White" FontWeight="Bold" FontSize="13" 
                        BorderThickness="0" Cursor="Hand" Click="OnActivateClicked">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="8"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </Grid>
        </Grid>
    </Border>
</Window>

